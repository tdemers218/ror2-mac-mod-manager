using BepInEx;
using BepInEx.Configuration;
using BepInEx.Logging;
using RoR2;
using UnityEngine.Networking;

namespace {{.Name}}
{
    // A gameplay tweak: players earn bonus gold for every enemy they kill.
    // Shows the three things most tweaks need: a hook, a server check, a setting.
    [BepInPlugin(PluginGUID, PluginName, PluginVersion)]
    public class {{.Name}}Plugin : BaseUnityPlugin
    {
        public const string PluginGUID = "{{.GUID}}";
        public const string PluginName = "{{.Name}}";
        public const string PluginVersion = "{{.Version}}";

        internal static ManualLogSource Log;
        internal static ConfigEntry<int> GoldPerKill;

        private void Awake()
        {
            Log = Logger;
            GoldPerKill = Config.Bind("General", "GoldPerKill", 5,
                "Extra gold a player gets for each kill.");

            // On.* hooks come from MMHOOK (generated by HookGenPatcher).
            // They wrap a game method: call orig to run the original code.
            On.RoR2.GlobalEventManager.OnCharacterDeath += GlobalEventManager_OnCharacterDeath;

            Log.LogInfo($"{PluginName} {PluginVersion} loaded");
        }

        private void GlobalEventManager_OnCharacterDeath(
            On.RoR2.GlobalEventManager.orig_OnCharacterDeath orig,
            GlobalEventManager self,
            DamageReport damageReport)
        {
            orig(self, damageReport);

            // Gameplay state only changes on the host; clients just display it.
            if (!NetworkServer.active || damageReport == null)
            {
                return;
            }

            CharacterMaster killer = damageReport.attackerMaster;
            if (killer != null && killer.playerCharacterMasterController != null)
            {
                killer.GiveMoney((uint)GoldPerKill.Value);
            }
        }
    }
}
